<?xml version="1.0" encoding="utf-8"?>
<subsection xml:id="course_prerequisites" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Course Prerequisites</title>
  <p component="undergraduate">
    The prerequisite for this course is Math 3073 or Math 3113.
  </p>
  <p component="graduate">
    The prerequisite for this course is Math 4353 or consent of the instructor.
  </p>
  <p>
    Students are expected to be comfortable reading and writing mathematical proofs.
  </p>
</subsection>
