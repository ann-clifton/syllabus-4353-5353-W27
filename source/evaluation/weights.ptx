<?xml version="1.0" encoding="utf-8"?>
<subsection xml:id="weights">
  <title>Weights</title>
  <p>
    Grades will be calculated out of the point totals below.
  </p>

  <assemblage component="undergraduate">
    <title>Evaluation Criteria</title>
    <tabular>
      <row header="yes" bottom="minor" >
	<cell>Grade Category</cell>
	<cell>Points</cell>
      </row>
      <row>
	<cell>Homework</cell>
	<cell>150</cell>
      </row>
      <row>
	<cell>Quizzes and Engagement</cell>
	<cell>150</cell>
      </row>
      <row>
	<cell>Midterm Exam</cell>
	<cell>100</cell>
      </row>
      <row>
	<cell>Final Exam</cell>
	<cell>100</cell>
      </row>
      <row bottom="minor" top="minor">
	<cell>Total</cell>
	<cell>500</cell>
      </row>
    </tabular>
  </assemblage>

  <assemblage component="graduate">
    <title>Evaluation Criteria</title>
    <tabular>
      <row header="yes" bottom="minor" >
	<cell>Grade Category</cell>
	<cell>Points</cell>
      </row>
      <row>
	<cell>Homework</cell>
	<cell>100</cell>
      </row>
      <row>
	<cell>Quizzes and Engagement</cell>
	<cell>100</cell>
      </row>
      <row>
	<cell>Excursion Report and Presentation</cell>
	<cell>100</cell>
      </row>
      <row>
	<cell>Midterm Exam</cell>
	<cell>100</cell>
      </row>
      <row>
	<cell>Final Exam</cell>
	<cell>100</cell>
      </row>
      <row bottom="minor" top="minor">
	<cell>Total</cell>
	<cell>500</cell>
      </row>
    </tabular>
  </assemblage>
</subsection>
