<?xml version="1.0" encoding="utf-8"?>
<subsection xml:id="grading_scale">
  <title>Grading Scale</title>

  <p>
    Letter grades will be assigned based on total points earned out of 500, using the scale below.
  </p>

  <assemblage>
    <title>Grading Scale</title>
    <tabular halign="center">
      <row header="yes" bottom="minor" >
	<cell>Points</cell>
	<cell>Letter Grade</cell>
      </row>
      <row>
	<cell><m>[450,500]</m></cell>
	<cell>A</cell>
      </row>
      <row>
	<cell><m>[400,450)</m></cell>
	<cell>B</cell>
      </row>
      <row>
	<cell><m>[350,400)</m></cell>
	<cell>C</cell>
      </row>
      <row>
	<cell><m>[300,350)</m></cell>
	<cell>D</cell>
      </row>
      <row>
	<cell><m>[0,300)</m></cell>
	<cell>F</cell>
      </row>
    </tabular>
  </assemblage>
</subsection>
